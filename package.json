{
  "name": "delta-harvest-advisor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "低频读取 moligod 特勤处快照并生成三角洲收菜建议",
  "scripts": {
    "run": "node src/cli.mjs run",
    "run:notify": "node src/cli.mjs run --notify",
    "build:web": "node src/build-web.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "test": "node --test",
    "task:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-scheduled-task.ps1",
    "task:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-scheduled-task.ps1"
  },
  "engines": {
    "node": ">=22"
  }
}
