{
  "name": "shoucai-state",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shoucai",
      "database_id": "请替换为Cloudflare创建的D1数据库ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://maofaw.github.io",
    "FEISHU_RECEIVE_ID_TYPE": "open_id",
    "NOTIFICATION_COOLDOWN_HOURS": "24"
  }
}
